# ─────────────────────────────────────────────────────────────────────────────
# HealthTrack API — environment template
# Copy to .env and fill in real values. .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32

# ── Database (Postgres) ──────────────────────────────────────────────────────
# DB_HOST=db when running via docker compose; localhost when running tests directly
DB_HOST=db
DB_PORT=5432
DB_NAME=healthtrack
DB_USER=healthtrack_app
DB_PASSWORD=CHANGE_ME_strong_random_password

# ── Cache (Redis) ────────────────────────────────────────────────────────────
REDIS_URL=redis://cache:6379/0

# ── Anthropic API (for plugins/run_skill.py and CI ai-skills job) ────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
